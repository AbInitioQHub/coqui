 &control
    calculation = 'scf',
    verbosity = 'high',
    outdir = './',
    prefix = 'pwscf',
    pseudo_dir = './'
 /
 &system
    ibrav=2, celldm(1)=10.2,
    nat=2, ntyp=1,
    ecutwfc=12.0,
    nbnd=8,
    force_symmorphic=.true.,
    occupations='fixed'
 /
 &electrons
    conv_thr=1e-10,
 /
ATOMIC_SPECIES
 Si  28.0855  Si_ONCV_PBE_sr.upf
ATOMIC_POSITIONS {alat}
 Si 0.00 0.00 0.00
 Si 0.25 0.25 0.25
K_POINTS {automatic}
 3 3 3 0 0 0
